Menu="Buttons:299"
Link="nav-user"
---
<script>
(function () {
  // Legacy header (Unraid <= 7.3), unified header logo block (7.4+; the
  // a.uh-logo class only exists in newer API builds), and the boot
  // placeholder shown by Header.php before <unraid-header> mounts.
  const SELECTORS = [
    'unraid-header-os-version a[href]',
    'unraid-header .uh-logo-block a[href]',
    'unraid-header a.uh-logo',
    '.unraid-header-boot-logo a'
  ].join(', ');

  const isLogoLink = (link) => {
    try {
      const url = new URL(link.href);
      return (url.hostname === 'unraid.net' || url.hostname === 'www.unraid.net') &&
        url.pathname === '/' && !url.search && !url.hash;
    } catch (_) {
      return false;
    }
  };

  const replaceLinks = () => {
    document.querySelectorAll(SELECTORS).forEach((link) => {
      if (!isLogoLink(link)) return;
      link.href = '/';
      link.removeAttribute('target');
      link.removeAttribute('rel');
    });
  };

  replaceLinks();

  // Keep observing: on 7.4 the boot placeholder is replaced by the Vue
  // component, and the header can re-render after mount.
  let scheduled = false;
  const observer = new MutationObserver(() => {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(() => {
      scheduled = false;
      replaceLinks();
    });
  });

  observer.observe(document.documentElement, {
    childList: true,
    subtree: true,
    attributes: true,
    attributeFilter: ['href']
  });
})();
</script>
<style>
/* Legacy header (Unraid <= 7.3): below 768px, #UserProfile (server name,
   bell, avatar) sits above the logo with a transparent left padding that
   swallows taps. Let taps pass through the box; its content stays
   clickable. The unified 7.4 header has no #UserProfile, so nothing changes. */
@media (max-width: 767px) {
  #header #UserProfile {
    pointer-events: none;
  }

  #header #UserProfile > * {
    pointer-events: auto;
  }
}
</style>
