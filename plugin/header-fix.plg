<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN 
  name="header-fix"
  author="EllipticSet"
  version="2026.10.24.1600"
  
  pluginURL="https://raw.githubusercontent.com/EllipticSet/unraid-header-fix/main/plugin/header-fix.plg"
  support="https://github.com/EllipticSet/unraid-header-fix/issues"
  min="7.1.0"
  
  icon="fa-wrench"
>

<CHANGES>
<![CDATA[

### 2026.10.24.1600

## What's Changed
* Fix the logo link on Unraid 7.4.0-rc.2, whose header does not use the uh-logo class
* Only the unraid.net home link in the header logo is rewritten; other unraid.net links are left unchanged

### 2026.10.24.0000

## What's Changed
* Support the unified Unraid 7.4 header (logo and boot placeholder)
* Plugin maintained at EllipticSet/unraid-header-fix


For older releases, see https://github.com/EllipticSet/unraid-header-fix/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/header-fix/unraid-header-fix-2026.10.24.1600-noarch-1.txz">
<URL>https://github.com/EllipticSet/unraid-header-fix/releases/download/2026.10.24.1600/unraid-header-fix-2026.10.24.1600-noarch-1.txz</URL>
<SHA256>73bd9483cce184930ecf7481adc7c60ea2f3b1eb3b0f5672e2696f10a8c0fb9f</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
upgradepkg --install-new /boot/config/plugins/header-fix/unraid-header-fix-2026.10.24.1600-noarch-1.txz

# cleanup old versions
rm -f $(ls /boot/config/plugins/header-fix/unraid-header-fix-*.txz 2>/dev/null | grep -v '2026.10.24.1600')

echo ""
echo "----------------------------------------------------"
echo " header-fix has been installed."
echo " Version: 2026.10.24.1600"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg unraid-header-fix

rm -rf /usr/local/emhttp/plugins/header-fix
rm -rf /boot/config/plugins/header-fix
]]>
</INLINE>
</FILE>

</PLUGIN>
