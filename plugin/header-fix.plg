<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN 
  name="header-fix"
  author="EllipticSet"
  version="2026.10.24.0000"
  
  pluginURL="https://raw.githubusercontent.com/EllipticSet/unraid-header-fix/main/plugin/header-fix.plg"
  support="https://github.com/EllipticSet/unraid-header-fix/issues"
  min="7.1.0"
  
  icon="fa-wrench"
>

<CHANGES>
<![CDATA[

### 2026.10.24.0000

## What's Changed
* Support the unified Unraid 7.4 header (logo and boot placeholder)
* Plugin maintained at EllipticSet/unraid-header-fix


For older releases, see https://github.com/EllipticSet/unraid-header-fix/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/header-fix/unraid-header-fix-2026.10.24.0000-noarch-1.txz">
<URL>https://github.com/EllipticSet/unraid-header-fix/releases/download/2026.10.24.0000/unraid-header-fix-2026.10.24.0000-noarch-1.txz</URL>
<SHA256>21ee86945b89e4dd1d08fa18fee9bc340adf6475f7437703b2cb2069973d37cb</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
upgradepkg --install-new /boot/config/plugins/header-fix/unraid-header-fix-2026.10.24.0000-noarch-1.txz

# cleanup old versions
rm -f $(ls /boot/config/plugins/header-fix/unraid-header-fix-*.txz 2>/dev/null | grep -v '2026.10.24.0000')

echo ""
echo "----------------------------------------------------"
echo " header-fix has been installed."
echo " Version: 2026.10.24.0000"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg unraid-header-fix

rm -rf /usr/local/emhttp/plugins/header-fix
rm -rf /boot/config/plugins/header-fix
]]>
</INLINE>
</FILE>

</PLUGIN>
