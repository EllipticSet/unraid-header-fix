<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN 
  name="header-fix"
  author="EllipticSet"
  version="2026.10.18.0000"
  
  pluginURL="https://raw.githubusercontent.com/EllipticSet/unraid-header-fix/main/plugin/header-fix.plg"
  support="https://github.com/EllipticSet/unraid-header-fix/issues"
  min="7.1.0"
  
  icon="fa-wrench"
>

<CHANGES>
<![CDATA[

### 2026.10.18.0000

## End of Support

With the news around U8, I'm deciding to step back from maintaining any plugins that I don't actively use. As such, I won't be doing any further updates to the plugin. I will leave it in Community Applications. If someone wants to fork the plugin and continue maintaining it, feel free; once a replacement is ready, I'd be happy to help facilitate the migration to the new repo.

### 2026.03.19.2240

## What's Changed
* fix: name format on plugins page


### 2026.01.07.02

- Add link to support thread


For older releases, see https://github.com/dkaser/unraid-header-fix/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/header-fix/unraid-header-fix-2026.10.18.0000-noarch-1.txz">
<URL>https://github.com/dkaser/unraid-header-fix/releases/download/2026.10.18.0000/unraid-header-fix-2026.10.18.0000-noarch-1.txz</URL>
<SHA256>b531d6f4465a8ee6a71deabe8a6899a1fb603124cc844219f2dab104b632ec5c</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
upgradepkg --install-new /boot/config/plugins/header-fix/unraid-header-fix-2026.10.18.0000-noarch-1.txz

# cleanup old versions
rm -f $(ls /boot/config/plugins/header-fix/unraid-header-fix-*.txz 2>/dev/null | grep -v '2026.10.18.0000')

echo ""
echo "----------------------------------------------------"
echo " header-fix has been installed."
echo " Version: 2026.10.18.0000"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg unraid-header-fix

rm -rf /usr/local/emhttp/plugins/header-fix
rm -rf /boot/config/plugins/header-fix
]]>
</INLINE>
</FILE>

</PLUGIN>
