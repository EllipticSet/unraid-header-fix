>

<CHANGES>
<![CDATA[

### 2026.03.19.2240

## What's Changed
* fix: name format on plugins page


### 2026.01.07.02

- Add link to support thread

### 2026.01.07.01

- Set min Unraid version


For older releases, see https://github.com/dkaser/unraid-header-fix/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/header-fix/unraid-header-fix-2026.03.19.2240-noarch-1.txz">
<URL>https://github.com/dkaser/unraid-header-fix/releases/download/2026.03.19.2240/unraid-header-fix-2026.03.19.2240-noarch-1.txz</URL>
<SHA256>b00e915d3b75262f3de489c69a81026576413fc1bf1d373ed1105e0dcdb23792</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
upgradepkg --install-new /boot/config/plugins/header-fix/unraid-header-fix-2026.03.19.2240-noarch-1.txz

# cleanup old versions
rm -f $(ls /boot/config/plugins/header-fix/unraid-header-fix-*.txz 2>/dev/null | grep -v '2026.03.19.2240')

echo ""
echo "----------------------------------------------------"
echo " header-fix has been installed."
echo " Version: 2026.03.19.2240"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg unraid-header-fix

rm -rf /usr/local/emhttp/plugins/header-fix
rm -rf /boot/config/plugins/header-fix
]]>
</INLINE>
</FILE>

</PLUGIN>
