  <FILE Run="/bin/bash" Method="remove">
    <INLINE>removepkg unraid-header-fix || true
rm -rf /usr/local/emhttp/plugins/header-fix
rm -rf /boot/config/plugins/header-fix
echo "WebGUI Header Link Fix has been removed."
</INLINE>
